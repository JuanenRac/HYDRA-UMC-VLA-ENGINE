# --workspace points at a real root:root 0755 tree under /opt (see
# install_vla_engine.sh), the same layout check_engine_status() already
# expects (workspace/HYDRA-UMC-COGNITIVE-NODE/models/). Deliberately NOT
# a symlink to the real sibling-repo checkout root - real bug found live
# installing HYDRA-UMC-VISION-NODE first: that root lives under the
# operator's home directory (0700, Debian's own default), unreadable by
# this service's own unprivileged account no matter how ProtectHome is
# set. ProtectHome stays this family's usual "true" - nothing under
# /home/ needs to be reachable any more.
[Unit]
Description=HYDRA-UMC-VLA-ENGINE real action-tokenization/trajectory API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hydra-umc-vla-engine
Group=hydra-umc-vla-engine
WorkingDirectory=/opt/hydra-umc/vla-engine
Environment=PYTHONPATH=/opt/hydra-umc/vla-engine/src
ExecStart=/usr/bin/python3 -m hydra_umc_vla_engine.main serve --addr 127.0.0.1 --port 8098 --workspace /opt/hydra-umc/vla-engine/workspace
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
